pragma language_version 0.28.0;

// Wraps an unshielded token into a shielded note that stands for it, and
// redeems the note back into the token. Two circuits, no circuit for an
// administrator, no pause and no stored totals: a pool is this contract's
// public balance of one backing token, kept by the ledger. A redeemed note is
// kept by this contract, which has no circuit that can spend it. Nothing in
// this source stops a circuit being added after deployment; only deploying it
// with no maintenance authority does.
//
// A recipient may be a wallet or a contract. The ledger refuses a mint or a
// payment addressed to a contract that does not take it in the same
// transaction, so neither can be stranded there; the one recipient it would
// let through and strand is this contract itself, which no circuit here can
// spend from. Both circuits refuse it.

import CompactStandardLibrary;

// Whether a mint recipient is the all-zero key or the all-zero address,
// reading only the branch taken: its bytes are selected, then compared with
// zero. A coin sent to either can never be spent.
circuit isZeroCoinRecipient(to: Either<ZswapCoinPublicKey, ContractAddress>): Boolean {
  return (to.is_left ? to.left.bytes : to.right.bytes) == default<Bytes<32>>;
}

// Whether a mint recipient is this contract. Only the branch taken is read:
// comparing the whole value would let a caller name this contract with
// anything at all in the other branch and be told it is somebody else.
// `self` is this contract's address, read once by the calling circuit.
circuit isThisContract(to: Either<ZswapCoinPublicKey, ContractAddress>, self: ContractAddress): Boolean {
  return !to.is_left && to.right == self;
}

// Whether a payout recipient is the all-zero contract or user address, read
// the same way. A payment to either can never be spent from again.
circuit isZeroPayee(to: Either<ContractAddress, UserAddress>): Boolean {
  return (to.is_left ? to.left.bytes : to.right.bytes) == default<Bytes<32>>;
}

// Whether a payout recipient is this contract, read the same way. `self` is
// this contract's address, read once by the calling circuit.
circuit paysThisContract(to: Either<ContractAddress, UserAddress>, self: ContractAddress): Boolean {
  return to.is_left && to.left == self;
}

// Takes `amount` of the unshielded token `backing` into this contract and
// mints `amount` of the shielded note that stands for it to `to`, returning
// the minted coin.
//
// The note's colour is `tokenType(backing, this contract)`: a function of the
// token being wrapped and of this address and nothing else, so there is one
// pool per backing token and nobody chooses it. What is taken in and what is
// minted are one `backing` and one `amount`, so they cannot disagree.
// `amount` is a Uint<64>, the protocol's mint ceiling, so a wrap above it
// cannot be expressed.
//
// Refused: an amount of zero, a recipient that is the zero key or the zero
// address, and this contract as recipient, where the coin would sit with no
// circuit able to spend it.
//
// Whether a wallet recipient ever sees its note is not decided here. The
// encrypted copy a wallet scans for is attached by whatever builds the
// transaction, from a key no circuit can reach. A contract recipient takes the
// returned coin in the same transaction or the ledger refuses the mint.
export circuit wrap(
  backing: Bytes<32>,
  amount: Uint<64>,
  to: Either<ZswapCoinPublicKey, ContractAddress>,
  nonce: Bytes<32>
): ShieldedCoinInfo {
  const recipient = disclose(to);
  const self = kernel.self();
  assert(disclose(amount) != 0, "the amount to wrap is zero");
  assert(!isZeroCoinRecipient(recipient), "the recipient is the zero key or the zero address");
  assert(!isThisContract(recipient, self), "the recipient is this contract, which could never spend the coin");
  receiveUnshielded(disclose(backing), disclose(amount) as Uint<128>);
  return mintShieldedToken(disclose(backing), disclose(amount), disclose(nonce), recipient);
}

// Takes `coin` in and keeps it, and pays the same number of units of
// `backing` to `to`, a contract or a user address.
//
// `backing` is both the pool the coin must belong to and the token paid out,
// and `coin.value` is both what is taken in and what is paid, so taking a coin
// of one pool and paying from another, or paying more than is taken in,
// cannot be expressed. A coin of another token, of another pool, or of another
// converter is refused by its colour.
//
// The coin is taken in whole and stays with this contract. No circuit here
// spends a shielded coin, so a redeemed note never moves again and the backing
// paid against it is paid only once, for as long as no circuit is added. That
// is why this contract must be deployed with no maintenance authority (an
// empty committee, threshold at least 1): a contract that could take a new
// circuit could spend every note it holds.
//
// Refused: a payout to the zero address of either kind, which nobody can ever
// spend from; a payout to this contract, which would return the backing to
// the pool and leave the holder with nothing; a coin of the wrong colour; and
// a coin worth nothing. The coin is redeemed whole, at its value.
export circuit redeem(
  backing: Bytes<32>,
  coin: ShieldedCoinInfo,
  to: Either<ContractAddress, UserAddress>
): [] {
  const payee = disclose(to);
  const redeemed = disclose(coin);
  const self = kernel.self();
  assert(!isZeroPayee(payee), "the payout address is the zero address, which nobody can ever spend from");
  assert(!paysThisContract(payee, self), "the payout address is this contract, which would keep the payout in the pool");
  assert(redeemed.color == tokenType(disclose(backing), self),
    "the coin is not of this contract's colour for that backing token");
  assert(redeemed.value != 0, "the coin is worth nothing");
  receiveShielded(redeemed);
  sendUnshielded(disclose(backing), redeemed.value, payee);
}
