{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts",
    "test",
    "contracts/*/scripts",
    "contracts/*/test",
    "packages/*/src",
    "packages/*/test",
    "tools/*/src",
    "tools/*/test",
    "apps/*/src",
    "apps/*/test"
  ]
}
