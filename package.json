{
  "name": "native-token-converter-workspace",
  "description": "Wrap an unshielded Midnight token into a shielded one, and redeem it back, with one pool per backing colour.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Private-Payroll/native-token-converter.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "contracts/*",
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "compact": "tsx contracts/converter/scripts/compile.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "build": "npm run build --workspace packages/library",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "self-contained": "tsx scripts/check-self-contained.ts",
    "verify": "npm run format:check && npm run compact && npm run build && npm run self-contained && npm run typecheck && npm run lint && vitest run",
    "pretest": "npm run compact",
    "compile:keys": "tsx tools/toolchain/src/compile-with-keys.ts",
    "local-chain:start": "tsx tools/local-chain/src/cli.ts start",
    "local-chain:stop": "tsx tools/local-chain/src/cli.ts stop",
    "check:local-chain": "npm run compile:keys && tsc -p tsconfig.local-chain.json && LOCAL_CHAIN_LINT=1 eslint --max-warnings 0 contracts/*/test/local-chain",
    "test:local-chain": "tsx tools/local-chain/src/cli.ts check && npm run check:local-chain && vitest run --config vitest.local-chain.config.ts"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@openzeppelin/compact-contracts": "0.4.0",
    "@types/node": "22.20.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "overrides": {
    "@midnightntwrk/ledger-v9": "1.0.1",
    "archiver-utils": {
      "glob": "12.0.0"
    }
  }
}
