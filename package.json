{
  "name": "native-token-converter-workspace",
  "description": "Wrap an unshielded Midnight token into a shielded one, and redeem it back, with one pool per backing colour.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Private-Payroll/native-token-converter.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "contracts/*",
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "compact": "tsx contracts/converter/scripts/compile.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspace packages/library",
    "format": "prettier --write .",
    "test": "vitest run",
    "self-contained": "tsx scripts/check-self-contained.ts",
    "verify": "prettier --check . && npm run compact && npm run build && npm run self-contained && npm run typecheck && vitest run",
    "pretest": "npm run compact"
  },
  "devDependencies": {
    "@openzeppelin/compact-contracts": "0.4.0-alpha.1",
    "@types/node": "22.20.1",
    "prettier": "3.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
